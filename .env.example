# Owner connection: migrations, authentication, system jobs.
DATABASE_URL=postgresql://aml:change-me@localhost:5432/amlsyncai
# Non-superuser connection for tenant data — row-level security applies (prisma/rls.sql).
DATABASE_APP_URL=postgresql://app_user:change-me@localhost:5432/amlsyncai

# Public URL. Use https:// in every real deployment (secure cookies, upgrade-insecure-requests).
APP_URL=http://localhost:3000

# 32 random bytes, base64 (openssl rand -base64 32). Per-firm field encryption keys are
# derived from it. In production keep it in an EU-region KMS/secrets vault.
MASTER_KEY=

# Sign-up: "invite" (default) needs a code from scripts/create-signup-code.mts; "open" lets
# any company email sign up.
SIGNUP_MODE=invite

# Email: "dev" stores mail in the database (see /dev/mailbox); "smtp" uses SMTP_URL.
EMAIL_TRANSPORT=dev
SMTP_URL=
EMAIL_FROM="AMLSyncAI <no-reply@example.eu>"

# Local development only — never set these in production.
# SKIP_DOMAIN_CHECKS=1   # skip MX / domain-age lookups
# SKIP_BREACH_CHECK=1    # skip the breached-password API
# ALLOW_DEV_EMAIL=1      # allow the dev mail transport with NODE_ENV=production
# SCAN_MODE=basic      # dev only: EICAR check without ClamAV (production: set CLAMD_HOST)
# CLAMD_HOST=localhost:3310
# STORAGE_DIR=.data/files
# CRON_SECRET=          # bearer token for /api/cron/* (rescreen, portal-reminders)
# PLATFORM_ADMIN_EMAILS=   # AMLSyncAI team members who can triage feature requests (comma-separated)
