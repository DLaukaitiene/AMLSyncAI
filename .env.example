# Owner connection: migrations, authentication, system jobs.
DATABASE_URL=postgresql://aml:change-me@localhost:5432/amlsyncai
# Non-superuser connection for tenant data — row-level security applies (prisma/rls.sql).
DATABASE_APP_URL=postgresql://app_user:change-me@localhost:5432/amlsyncai

# Public URL. Use https:// in every real deployment (secure cookies, upgrade-insecure-requests).
APP_URL=http://localhost:3000

# 32 random bytes, base64 (openssl rand -base64 32). Per-firm field encryption keys are
# derived from it. In production keep it in an EU-region KMS/secrets vault.
MASTER_KEY=

# Sign-up: "invite" (default) needs a code from scripts/create-signup-code.mts; "open" lets
# any company email sign up.
SIGNUP_MODE=invite

# Email: "dev" stores mail in the database (see /dev/mailbox); "smtp" uses SMTP_URL.
EMAIL_TRANSPORT=dev
SMTP_URL=
EMAIL_FROM="AMLSync App <no-reply@example.eu>"

# Local development only — never set these in production.
# SKIP_DOMAIN_CHECKS=1   # skip MX / domain-age lookups
# SKIP_BREACH_CHECK=1    # skip the breached-password API
# ALLOW_DEV_EMAIL=1      # allow the dev mail transport with NODE_ENV=production
# SCAN_MODE=basic      # dev only: EICAR check without ClamAV (production: set CLAMD_HOST)
# CLAMD_HOST=localhost:3310
# STORAGE_DIR=.data/files
# CRON_SECRET=          # bearer token for /api/cron/* (rescreen, portal-reminders)
# Backoffice (/adminpage1&): production always allows only deimena@amlsync.com. Tests and previews:
# BACKOFFICE_OWNER_EMAIL=     # the one admin (default deimena@amlsync.com)
# BACKOFFICE_TEAM=on          # further admins and roles (ignored in production)
# AI drafting (spec §5): off (default) | vertex (Claude on Vertex AI, EU region) | anthropic (Claude API) | mock (tests only)
# AI_PROVIDER=off
# VERTEX_PROJECT_ID=
# VERTEX_REGION=europe-west1
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5
# Didit (identity checks + provider AML screening, EU processing)
# DIDIT_API_KEY=            # sk_test_… (sandbox, free, mocked) or sk_live_…
# DIDIT_WORKFLOW_ID=        # KYC workflow: eID wallets → document + NFC + liveness + face match + AML
# DIDIT_WEBHOOK_SECRET=     # webhook destination secret (X-Signature-V2); URL: https://<app>/api/webhooks/didit
# DIDIT_SANDBOX_AML_SCENARIO= # sandbox only, e.g. review_aml_possible_match
# Storage on Supabase (S3-compatible): STORAGE_DRIVER=s3, S3_ENDPOINT=https://<ref>.supabase.co/storage/v1/s3, S3_REGION, S3_BUCKET, S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY
# Invoices: seller and bank details are in src/lib/billing/invoice.ts; plans and limits in src/lib/billing/plans.ts
# Email via Google Workspace (amlsync.com): SMTP relay or a mailbox with an app password
# SMTP_URL=smtps://no-reply%40amlsync.com:<app-password>@smtp.gmail.com:465
# EMAIL_FROM="AMLSync App <no-reply@amlsync.com>"
