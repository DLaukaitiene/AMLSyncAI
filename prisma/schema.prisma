// AMLSyncAI core data model (spec §8A).
//
// Multi-tenant: every tenant-owned table carries firmId and is protected by
// PostgreSQL row-level security (see prisma/rls.sql). Decision objects store
// the EU Core version and Country Profile version in force (spec §3A.3, §11.0).
// Field-level encrypted columns (spec §8C.6) are stored as Bytes with an
// "Enc" suffix and are encrypted/decrypted in the application with the firm's key.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  OWNER // Owner / Compliance Manager (member of the management body, Art. 11)
  COMPLIANCE_OFFICER
  STAFF
  EXTERNAL_REVIEWER // AMLSync Expert: recommend only (Art. 18)
  READ_ONLY // supervisor / auditor view
}

enum Sector {
  ACCOUNTANT
  ESTATE_AGENT
  HVG_TRADER
  PRECIOUS_METALS
  TCSP
  LEGAL
  ART_TRADER
  GAMBLING
  CROWDFUNDING
  CREDIT_INTERMEDIARY
  INVESTMENT_MIGRATION
  FOOTBALL
  OTHER
}

enum PartyKind {
  NATURAL
  LEGAL
  ARRANGEMENT
}

enum PartyRole {
  CLIENT
  BUYER
  SELLER
  LANDLORD
  TENANT
  SUPPLIER
  REPRESENTATIVE
  BENEFICIARY
  OTHER
}

enum MatterType {
  ENGAGEMENT
  PROPERTY_SALE
  LETTING
  GOODS_SALE
  COMPANY_FORMATION
  TRANSACTION
  OTHER
}

enum MatterStatus {
  OPEN
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum CddStatus {
  OPEN
  COMPLETE
  SDD
  EDD
  REFUSED
  TERMINATED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum VerificationMethod {
  EID
  IN_PERSON
  DOCUMENT_NFC_LIVENESS
  DOCUMENT_LIVENESS // remote document + liveness without a chip read (weaker; reason recorded)
}

enum OwnershipLinkType {
  SHAREHOLDING
  CONTROL
  TRUST_SETTLOR
  TRUSTEE
  TRUST_PROTECTOR
  TRUST_BENEFICIARY
  NOMINEE
  SENIOR_MANAGING_OFFICIAL
  DIRECTOR // board member / senior management of a legal entity (identified, not an owner)
}

enum DataSource {
  REGISTER
  DECLARATION
  UPLOADED_EXTRACT
}

enum ScreeningListKind {
  SANCTIONS
  PEP
  ADVERSE_MEDIA
}

enum MatchDecision {
  NO_MATCH // screened, nothing found — kept as evidence with list version and time
  PENDING
  TRUE_MATCH
  FALSE_POSITIVE
}

enum CaseType {
  INTERNAL_SUSPICION
  SANCTIONS_HIT
  DISCREPANCY
  FIU_REQUEST
}

enum ReportType {
  STR
  THRESHOLD
  CASH
  DISCREPANCY
  SANCTIONS_NOTICE
  SUPERVISOR_NOTICE
}

enum ReportStatus {
  DRAFT
  EXPORTED
  SUBMITTED
}

enum TaskStatus {
  OPEN
  DONE
  CANCELLED
}

enum ApprovalDecision {
  APPROVED
  REJECTED
}

enum DocumentStatus {
  DRAFT
  PENDING_APPROVAL
  IN_FORCE
  SUPERSEDED
}

enum FeatureRequestStatus {
  RECEIVED
  UNDER_REVIEW
  PLANNED
  IN_PROGRESS
  RELEASED
  NOT_PLANNED
}

// ---------------------------------------------------------------------------
// Firm, offices, users
// ---------------------------------------------------------------------------

model Firm {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  emailDomain   String   @unique // one firm per domain (§8C.2)
  homeState     String   @db.Char(2)
  sectors       Sector[]
  size          Int?
  services      String[]
  clientTypes   String[]
  usesCash      Boolean  @default(false)
  crossBorderPct Int?
  sectorOther   String?  // description when the sector is OTHER
  defaultCddScope String @default("full") // scope for new client files: full | identification-only
  // Subscription ended: records stay read-only (archive) until archiveUntil, then retention deletes them.
  status        String    @default("active") // active | paused | suspended (Backoffice) | cancelled
  cancelledAt   DateTime?
  archiveUntil  String?   // YYYY-MM-DD
  shareCode     String?  @unique // given to another firm so it can send this firm a client file
  plan          String   @default("starter") // solo | starter | custom (src/lib/billing/plans.ts)
  trialEndsOn   String?  // YYYY-MM-DD; no subscription fee before this date
  // Screening limits (adjusted by AMLSyncAI on request, within 1 business day)
  aiDrafting       Boolean @default(false) // the firm switched on AI drafting (STR narratives, policy text)
  responsibilities Json @default("{}") // AML duty → user ids (Team → Responsibilities)
  txCashThresholdEUR      Int @default(3000) // transaction monitoring: cash at or above this is flagged
  txHighValueThresholdEUR Int @default(50000) // any payment at or above this is flagged
  txCashLegalLimitEUR     Int @default(5000) // legal cash payment limit (LT: €5,000 since 1 Nov 2022); cash above it is flagged (R2, R3)
  txCashLimitCheckedAt    DateTime? // when the firm last checked the legal limit
  txRulesOff              String[] @default([]) // monitoring rules switched off by the firm, e.g. ["R8", "R10"]
  screenLimitMinute Int  @default(5)
  screenLimitDay    Int  @default(30)
  screenLimitMonth  Int  @default(100)
  autoClearBelow Int?    // screening: non-sanctions hits under this match score are auto-cleared (logged); null = off
  // Billing (postpaid, monthly invoice by bank transfer)
  billingName     String?
  billingAddress  String?
  billingCountry  String?  @db.Char(2) // defaults to homeState
  billingCompanyCode String?
  vatId           String?
  billingEmail    String?
  billingOffice   String?  // if established in several countries: which office receives the service
  vatNotRegistered Boolean @default(false) // the firm stated it isn't VAT-registered
  invoiceReference String? // PO or reference number to show on invoices
  billingConfirmedAt DateTime? // when the firm confirmed its invoice details (asked once, before the first invoice)
  customFeeCents  Int?     // overrides the plan's list price (custom plans, discounts)
  spendLimitCents Int      @default(30000) // paid checks per calendar month (net); raised on request
  // status (above) is also set by AMLSyncAI in the Backoffice (§6.2): paused and suspended block new
  // checks and screenings, read access and retention continue; closing a firm sets cancelled.
  statusReason    String?
  statusChangedAt DateTime?
  // VIES check of vatId (Backoffice §9.3)
  viesStatus      String?  // valid | invalid | unavailable
  viesName        String?
  viesCheckedAt   DateTime?
  createdAt     DateTime @default(now())

  offices               Office[]
  users                 User[]
  countryProfiles       CountryProfileVersion[]
  riskAssessments       FirmRiskAssessment[]
  policies              PolicyDocument[]
  parties               Party[]
  matters               Matter[]
  cases                 Case[]
  tasks                 Task[]
  approvals             Approval[]
  auditEvents           AuditEvent[]
  securityEvents        SecurityEvent[]
  emailDomainVerification EmailDomainVerification?
  featureRequests       FeatureRequest[]
}

model Office {
  id          String  @id @default(uuid()) @db.Uuid
  firmId      String  @db.Uuid
  firm        Firm    @relation(fields: [firmId], references: [id])
  name        String
  memberState String  @db.Char(2)
  isHome      Boolean @default(false)
  matters     Matter[]

  @@index([firmId])
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  firmId        String    @db.Uuid
  firm          Firm      @relation(fields: [firmId], references: [id])
  email         String    @unique
  name          String
  roles         Role[]
  external      Boolean   @default(false) // §8C.3: labelled everywhere
  passwordHash  String? // Argon2id
  emailVerifiedAt DateTime?
  mfaEnrolledAt DateTime?
  totpSecretEnc Bytes? // field-level encrypted TOTP secret
  recoveryCodeHashes String[] // one-time recovery codes (Argon2id)
  failedLogins  Int       @default(0)
  lockedUntil   DateTime?
  guideHiddenAt DateTime? // dashboard guide dismissed
  emailSummary  String    @default("auto") // auto (weekly for Owner/Compliance Officer, off for others) | weekly | monthly | off
  newsConsent   Boolean? // may AMLSync email AML rule updates and product news? null = not asked yet
  newsConsentAt DateTime?
  deactivatedAt DateTime?
  createdAt     DateTime  @default(now())

  approvals     Approval[]
  auditEvents   AuditEvent[]
  sessions      Session[]

  @@index([firmId])
}

model EmailDomainVerification {
  id            String   @id @default(uuid()) @db.Uuid
  firmId        String   @unique @db.Uuid
  firm          Firm     @relation(fields: [firmId], references: [id])
  firmName      String
  emailDomain   String
  freeOrDisposable Boolean
  hasMx         Boolean
  domainAgeDays Int?
  confirmedAt   DateTime?
  createdAt     DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Rules: EU Core version is a string constant in code; Country Profiles are
// versioned per firm (and optionally per office for host states).
// ---------------------------------------------------------------------------

model CountryProfileVersion {
  id          String   @id @default(uuid()) @db.Uuid
  firmId      String   @db.Uuid
  firm        Firm     @relation(fields: [firmId], references: [id])
  officeId    String?  @db.Uuid // null = home-state profile
  memberState String   @db.Char(2)
  version     Int
  data        Json // validated by src/lib/rules/country-profile.ts
  enteredById String   @db.Uuid
  source      String?
  approvalId  String?  @unique @db.Uuid // Compliance Officer approval required (§3A.3)
  createdAt   DateTime @default(now())

  @@unique([firmId, officeId, version])
  @@index([firmId])
}

// ---------------------------------------------------------------------------
// Firm level
// ---------------------------------------------------------------------------

model FirmRiskAssessment {
  id              String         @id @default(uuid()) @db.Uuid
  firmId          String         @db.Uuid
  firm            Firm           @relation(fields: [firmId], references: [id])
  version         Int
  status          DocumentStatus @default(DRAFT)
  answers         Json
  result          Json // inherent risk, controls, residual risk, action list
  euCoreVersion   String
  countryProfileVersion Int
  aiSections      Json? // AI-drafted sections and human edits (§11.12)
  approvalId      String?        @unique @db.Uuid
  createdAt       DateTime       @default(now())

  @@unique([firmId, version])
}

model PolicyDocument {
  id            String         @id @default(uuid()) @db.Uuid
  firmId        String         @db.Uuid
  firm          Firm           @relation(fields: [firmId], references: [id])
  kind          String // "policy" | "procedure"
  version       Int
  status        DocumentStatus @default(DRAFT)
  content       Json
  euCoreVersion String
  approvalId    String?        @unique @db.Uuid
  createdAt     DateTime       @default(now())
  acknowledgements PolicyAcknowledgement[]

  @@unique([firmId, kind, version])
}

model PolicyAcknowledgement {
  id         String         @id @default(uuid()) @db.Uuid
  firmId     String         @db.Uuid
  policyId   String         @db.Uuid
  policy     PolicyDocument @relation(fields: [policyId], references: [id])
  userId     String         @db.Uuid
  acknowledgedAt DateTime   @default(now())

  @@unique([policyId, userId])
}

// ---------------------------------------------------------------------------
// Parties, ownership, matters
// ---------------------------------------------------------------------------

model Party {
  id          String    @id @default(uuid()) @db.Uuid
  firmId      String    @db.Uuid
  firm        Firm      @relation(fields: [firmId], references: [id])
  kind        PartyKind
  displayName String
  /// Natural: names, DOB, place of birth, nationalities, residence, occupation…
  /// Legal: legal form, reg. no., LEI, registered office, country of creation…
  details     Json
  nationalIdEnc Bytes? // field-level encrypted (§8C.6)
  taxIdEnc      Bytes?
  bearerShares  Boolean @default(false)
  createdAt   DateTime  @default(now())

  ownedBy       OwnershipLink[] @relation("owned")
  owns          OwnershipLink[] @relation("owner")
  matterRoles   MatterParty[]
  verifications IdentityVerification[]
  extracts      RegistryExtract[]
  screenings    ScreeningResult[]
  cddFiles      CddFile[]
  documents     Document[]

  @@index([firmId])
}

model OwnershipLink {
  id          String            @id @default(uuid()) @db.Uuid
  firmId      String            @db.Uuid
  ownerId     String            @db.Uuid
  owner       Party             @relation("owner", fields: [ownerId], references: [id], onDelete: Cascade)
  ownedId     String            @db.Uuid
  owned       Party             @relation("owned", fields: [ownedId], references: [id], onDelete: Cascade)
  type        OwnershipLinkType
  pct         Decimal?          @db.Decimal(9, 6)
  controlDescription String?
  source      DataSource
  heldFrom    DateTime? // Art. 62: date interest held
  heldUntil   DateTime?

  @@index([firmId])
  @@index([ownedId])
}

model Matter {
  id          String       @id @default(uuid()) @db.Uuid
  firmId      String       @db.Uuid
  firm        Firm         @relation(fields: [firmId], references: [id])
  officeId    String?      @db.Uuid
  office      Office?      @relation(fields: [officeId], references: [id])
  type        MatterType
  sector      Sector
  title       String
  status      MatterStatus @default(OPEN)
  details     Json // sector template answers: property, price, item, financing…
  createdAt   DateTime     @default(now())

  parties      MatterParty[]
  transactions Transaction[]

  @@index([firmId])
}

model MatterParty {
  id       String    @id @default(uuid()) @db.Uuid
  firmId   String    @db.Uuid
  matterId String    @db.Uuid
  matter   Matter    @relation(fields: [matterId], references: [id], onDelete: Cascade)
  partyId  String    @db.Uuid
  party    Party     @relation(fields: [partyId], references: [id], onDelete: Cascade)
  role     PartyRole
  roleOther String? // description when role is OTHER

  @@unique([matterId, partyId, role])
  @@index([firmId])
}

model Transaction {
  id          String   @id @default(uuid()) @db.Uuid
  firmId      String   @db.Uuid
  matterId    String   @db.Uuid
  matter      Matter   @relation(fields: [matterId], references: [id], onDelete: Cascade)
  customerId  String   @db.Uuid
  date        DateTime @db.Date
  amountEUR   Decimal  @db.Decimal(14, 2)
  originalAmount   Decimal? @db.Decimal(14, 2)
  originalCurrency String?  @db.Char(3)
  fxRate      Decimal? @db.Decimal(14, 6) // rate recorded at entry (§8B)
  method      String
  occasional  Boolean
  description String?
  thirdPartyPayer Boolean @default(false)
  fromCountry String? // country the funds come from (ISO 3166-1 alpha-2)
  // Transaction monitoring (Art. 26): pending | flagged | investigated | cleared
  monitorStatus String   @default("pending")
  flags       Json     @default("[]") // [{code, text}] from rules/transaction-flags
  reviewNote  String?
  reviewedById String?  @db.Uuid
  reviewedAt  DateTime?
  caseId      String?  @db.Uuid
  direction   String? // in | out
  counterpartyName String?
  externalId  String? // the firm's own reference (invoice no., bank ref): duplicate check on import
  importBatchId String? @db.Uuid
  createdAt   DateTime @default(now())

  @@index([firmId, customerId, date])
  @@index([firmId, externalId])
  @@index([importBatchId])
  @@index([firmId, monitorStatus])
}

// ---------------------------------------------------------------------------
// CDD
// ---------------------------------------------------------------------------

model CddFile {
  id            String    @id @default(uuid()) @db.Uuid
  firmId        String    @db.Uuid
  partyId       String    @db.Uuid
  party         Party     @relation(fields: [partyId], references: [id], onDelete: Cascade)
  role          PartyRole
  status        CddStatus @default(OPEN)
  purpose       String?
  nextRefreshOn DateTime? @db.Date
  sddVerifyBy   DateTime? @db.Date
  endedOn       DateTime? @db.Date // end of relationship / refusal → retention clock
  retentionUntil DateTime? @db.Date
  legalHoldUntil DateTime? @db.Date
  gateOverride  Json? // { byUserId, reason, at }
  eddChecklist  Json? // ids of completed Art. 34(4) items
  smoFallback   Json? // { officials: [...], stepsTaken } when no BO is found
  decidedAt     DateTime? // accepted / refused / terminated
  decidedById   String?   @db.Uuid
  decisionReason String?
  source        String    @default("new") // new | back-book
  remediation   Json? // back-book: { gaps, priority, importedAt, lastCddDate }
  scope         String    @default("full") // full | identification-only (service outside AMLR scope)
  scopeReason   String?   // reason code (rules/cdd-scope)
  scopeNote     String?
  scopeSetById  String?   @db.Uuid
  scopeSetAt    DateTime?
  createdAt     DateTime  @default(now())

  riskAssessments ClientRiskAssessment[]

  @@unique([partyId, role])

  @@index([firmId])
}

model IdentityVerification {
  id             String             @id @default(uuid()) @db.Uuid
  firmId         String             @db.Uuid
  partyId        String             @db.Uuid
  party          Party              @relation(fields: [partyId], references: [id], onDelete: Cascade)
  method         VerificationMethod
  assuranceLevel String? // eIDAS substantial / high
  provider       String?
  providerRef    String?
  fallbackReason String? // required when not eID (§11.5)
  details        Json? // provider snapshot without media URLs: extracted data, scores, warnings, timestamps
  verifiedAt     DateTime

  @@index([firmId])
}

model RegistryExtract {
  id         String     @id @default(uuid()) @db.Uuid
  firmId     String     @db.Uuid
  partyId    String     @db.Uuid
  party      Party      @relation(fields: [partyId], references: [id], onDelete: Cascade)
  register   String // e.g. "BRIS", "JANGIS"
  source     DataSource
  data       Json
  documentId String?    @db.Uuid
  retrievedAt DateTime

  @@index([firmId])
}

model ScreeningResult {
  id          String            @id @default(uuid()) @db.Uuid
  firmId      String            @db.Uuid
  partyId     String            @db.Uuid
  party       Party             @relation(fields: [partyId], references: [id], onDelete: Cascade)
  listKind    ScreeningListKind
  listName    String
  listVersion String
  matchData   Json
  decision    MatchDecision     @default(PENDING)
  reviewerId  String?           @db.Uuid
  comment     String?
  screenedAt  DateTime
  decidedAt   DateTime?

  @@index([firmId, partyId])
}

model ClientRiskAssessment {
  id            String    @id @default(uuid()) @db.Uuid
  firmId        String    @db.Uuid
  cddFileId     String    @db.Uuid
  cddFile       CddFile   @relation(fields: [cddFileId], references: [id], onDelete: Cascade)
  calculated    RiskLevel
  final         RiskLevel
  score         Int
  factors       Json
  overrideReason String?
  overrideById  String?   @db.Uuid
  rulesetVersion String
  euCoreVersion  String
  countryProfileVersion Int
  createdAt     DateTime  @default(now())

  @@index([firmId])
}

model Document {
  id          String   @id @default(uuid()) @db.Uuid
  firmId      String   @db.Uuid
  partyId     String?  @db.Uuid
  party       Party?   @relation(fields: [partyId], references: [id], onDelete: Cascade)
  kind        String // id, company-extract, proof-of-address, sof-evidence…
  storageKey  String // object storage key; served via short-lived signed URLs
  mimeType    String
  sizeBytes   Int
  sha256      String
  malwareScan String   @default("pending") // pending | clean | quarantined
  fileName    String   @default("file")
  uploadedBy  String   @default("staff") // "staff:<userId>" or "portal:<linkId>"
  uploadedAt  DateTime @default(now())

  @@index([firmId])
}

// ---------------------------------------------------------------------------
// Cases & reports (restricted: Compliance Officer only, §8C.7)
// ---------------------------------------------------------------------------

model Case {
  id          String   @id @default(uuid()) @db.Uuid
  firmId      String   @db.Uuid
  firm        Firm     @relation(fields: [firmId], references: [id])
  type        CaseType
  partyIds    String[] @db.Uuid
  matterIds   String[] @db.Uuid
  contentEnc  Bytes // field-level encrypted case content
  decision    String? // report | no-report (with reasons) — every assessment kept
  decisionReasons String?
  privilegeApplies Boolean @default(false)
  privilegeReason  String?
  holdStartedOn DateTime? @db.Date
  holdEndsOn    DateTime? @db.Date
  ownerVisible Boolean @default(false)
  status      String   @default("open") // open | decided | answered | resolved | closed
  dueOn       DateTime? @db.Date
  closedAt    DateTime?
  fiuInstruction String? // proceed | stop — recorded during the Art. 71 hold
  decidedAt   DateTime? // when the Compliance Officer recorded the decision
  suspicionFormedAt DateTime? // set once on a "report" decision; a DB trigger stops it being changed
  createdById String   @db.Uuid
  createdAt   DateTime @default(now())

  reports     Report[]

  @@index([firmId])
}

model Report {
  id           String       @id @default(uuid()) @db.Uuid
  firmId       String       @db.Uuid
  caseId       String?      @db.Uuid
  case         Case?        @relation(fields: [caseId], references: [id])
  matterId     String?      @db.Uuid
  type         ReportType
  status       ReportStatus @default(DRAFT)
  format       String
  contentEnc   Bytes
  submissionRef String?
  receiptDocumentId String? @db.Uuid
  euCoreVersion String
  countryProfileVersion Int
  createdAt    DateTime     @default(now())
  submittedAt  DateTime?

  @@index([firmId])
}

// ---------------------------------------------------------------------------
// Calendar, approvals, audit
// ---------------------------------------------------------------------------

model Task {
  id          String     @id @default(uuid()) @db.Uuid
  firmId      String     @db.Uuid
  firm        Firm       @relation(fields: [firmId], references: [id])
  kind        String // refresh, discrepancy-report, transaction-hold, fiu-request…
  objectType  String
  objectId    String     @db.Uuid
  dueOn       DateTime   @db.Date
  status      TaskStatus @default(OPEN)
  assigneeId  String?    @db.Uuid
  article     String?
  createdAt   DateTime   @default(now())

  @@index([firmId, status, dueOn])
}

/// Immutable: no UPDATE/DELETE (enforced in prisma/rls.sql).
model Approval {
  id          String           @id @default(uuid()) @db.Uuid
  firmId      String           @db.Uuid
  firm        Firm             @relation(fields: [firmId], references: [id])
  objectType  String
  objectId    String           @db.Uuid
  decision    ApprovalDecision
  reason      String?
  userId      String           @db.Uuid
  user        User             @relation(fields: [userId], references: [id])
  role        Role
  euCoreVersion String
  countryProfileVersion Int
  createdAt   DateTime         @default(now())

  @@index([firmId, objectType, objectId])
}

/// Append-only (enforced in prisma/rls.sql). Deliberately general: it never
/// stores values or anything that identifies a client, so it can be kept after
/// client data is deleted at the end of the retention period (spec §4.7).
model AuditEvent {
  id          BigInt   @id @default(autoincrement())
  firmId      String   @db.Uuid
  firm        Firm     @relation(fields: [firmId], references: [id])
  userId      String?  @db.Uuid
  user        User?    @relation(fields: [userId], references: [id])
  action      String // create | update | delete | view | export | approve | purge
  objectType  String
  objectId    String // random UUID, meaningless once the object is deleted
  fields      String[] // names of the fields changed — never their values
  at          DateTime @default(now())

  @@index([firmId, objectType, objectId])
}

model SecurityEvent {
  id        BigInt   @id @default(autoincrement())
  firmId    String?  @db.Uuid
  firm      Firm?    @relation(fields: [firmId], references: [id])
  userId    String?  @db.Uuid
  kind      String // login, login-failed, mfa-change, new-device, rate-limit, bot-block, export, staff-access
  ip        String?
  userAgent String?
  details   Json?
  at        DateTime @default(now())

  @@index([firmId, at])
}

// ---------------------------------------------------------------------------
// Feature requests (§4.10) — cross-tenant; firm names never shown to others
// ---------------------------------------------------------------------------

model FeatureRequest {
  id          String               @id @default(uuid()) @db.Uuid
  firmId      String               @db.Uuid
  firm        Firm                 @relation(fields: [firmId], references: [id])
  userId      String               @db.Uuid
  title       String
  problem     String
  frequency   String
  importance  String // nice-to-have | important | blocking
  module      String
  regulatory  Boolean              @default(false)
  legalReference String?
  status      FeatureRequestStatus @default(RECEIVED)
  statusReason String?
  releaseNoteUrl String?
  mergedIntoId String?             @db.Uuid
  hidden      Boolean              @default(false)
  createdAt   DateTime             @default(now())

  votes       FeatureVote[]
  comments    FeatureComment[]
  history     FeatureStatusChange[]

  @@index([status])
  @@index([userId, createdAt])
}

model FeatureComment {
  id        String         @id @default(uuid()) @db.Uuid
  requestId String         @db.Uuid
  request   FeatureRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  userId    String         @db.Uuid
  firmId    String         @db.Uuid
  fromTeam  Boolean        @default(false) // AMLSyncAI team
  text      String
  hidden    Boolean        @default(false)
  createdAt DateTime       @default(now())

  @@index([requestId])
}

model FeatureStatusChange {
  id        String               @id @default(uuid()) @db.Uuid
  requestId String               @db.Uuid
  request   FeatureRequest       @relation(fields: [requestId], references: [id], onDelete: Cascade)
  status    FeatureRequestStatus
  note      String?
  byEmail   String
  createdAt DateTime             @default(now())

  @@index([requestId])
}

model FeatureVote {
  id        String         @id @default(uuid()) @db.Uuid
  requestId String         @db.Uuid
  request   FeatureRequest @relation(fields: [requestId], references: [id])
  userId    String         @db.Uuid
  createdAt DateTime       @default(now())

  @@unique([requestId, userId])
}

// ---------------------------------------------------------------------------
// Authentication (spec §8C.2–8C.4)
// ---------------------------------------------------------------------------

enum SessionStage {
  MFA_SETUP // password ok, MFA not yet enrolled
  MFA_PENDING // password ok, waiting for TOTP / recovery code
  ACTIVE
}

model Session {
  id          String       @id // SHA-256 of the session token; the token itself is only in the cookie
  userId      String       @db.Uuid
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  firmId      String       @db.Uuid
  stage       SessionStage
  createdAt   DateTime     @default(now())
  lastSeenAt  DateTime     @default(now())
  expiresAt   DateTime // absolute timeout (12 h)
  mfaAt       DateTime? // last MFA — step-up needs < 5 min
  ip          String?
  userAgent   String?
  revokedAt   DateTime?

  @@index([userId])
}

/// One-time email tokens: sign-up confirmation, password reset.
model EmailToken {
  id        String    @id // SHA-256 of the token
  purpose   String // signup-confirm | password-reset
  email     String
  data      Json? // pending sign-up details (firm name, person, password hash)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}

model Invitation {
  id          String    @id @default(uuid()) @db.Uuid
  firmId      String    @db.Uuid
  email       String
  name        String
  roles       Role[]
  external    Boolean   @default(false)
  invitedById String    @db.Uuid
  tokenHash   String    @unique
  expiresAt   DateTime // 72 hours
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([firmId])
}

/// Platform-level sign-up codes issued by AMLSyncAI when SIGNUP_MODE=invite.
model SignupCode {
  id        String    @id // SHA-256 of the code
  note      String?
  maxUses   Int       @default(1)
  uses      Int       @default(0)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
}

model RateLimitBucket {
  key         String   @id
  windowStart DateTime
  count       Int
}

/// Dev/test mail transport only (EMAIL_TRANSPORT=dev). Never used in production.
model DevEmail {
  id        String   @id @default(uuid()) @db.Uuid
  to        String
  subject   String
  text      String
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Screening lists (spec §4.4, §7): EU / UN official lists and firm-uploaded
// national lists. PEP / RCA data comes from a provider (not yet connected).
// ---------------------------------------------------------------------------

model ScreeningList {
  id          String   @id @default(uuid()) @db.Uuid
  firmId      String?  @db.Uuid // null = shared official list (EU, UN)
  kind        ScreeningListKind
  name        String
  version     String
  loadedAt    DateTime @default(now())
  active      Boolean  @default(true)
  entries     ScreeningEntry[]

  @@index([firmId])
}

model ScreeningEntry {
  id          String        @id @default(uuid()) @db.Uuid
  listId      String        @db.Uuid
  list        ScreeningList @relation(fields: [listId], references: [id], onDelete: Cascade)
  entityType  String // person | entity
  names       String[] // primary name and aliases
  normalized  String[] // normalised forms for matching
  birthDates  String[]
  countries   String[]
  reference   String? // list reference / programme
  details     Json?

  @@index([listId])
  @@index([normalized], type: Gin)
}

// ---------------------------------------------------------------------------
// Client self-service portal (spec §4A.1, §8C.5)
// ---------------------------------------------------------------------------

enum PortalStatus {
  SENT
  OPENED
  SUBMITTED
  REVOKED
}

/// One link per party and CDD file. The URL holds only a random token, never personal data.
model PortalLink {
  id          String       @id @default(uuid()) @db.Uuid
  firmId      String       @db.Uuid
  partyId     String       @db.Uuid
  cddFileId   String       @db.Uuid
  tokenHash   String       @unique
  tokenEnc    Bytes // encrypted with the firm key, so reminders can re-send the same link
  sentTo      String // email the link and the one-time codes go to
  purpose     String       @default("onboarding") // onboarding | refresh
  status      PortalStatus @default(SENT)
  expiresAt   DateTime // 14 days, firm may set shorter
  codeHash    String?
  codeExpiresAt DateTime?
  codeAttempts Int         @default(0)
  sessionHash String? // portal session after the one-time code
  sessionExpiresAt DateTime?
  remindersSent Int        @default(0)
  lastReminderAt DateTime?
  submittedAt DateTime?
  submission  Json? // what the client declared (copied into the CDD file on submit)
  createdById String       @db.Uuid
  createdAt   DateTime     @default(now())

  @@index([firmId])
  @@index([cddFileId])
}

// ---------------------------------------------------------------------------
// Governance and firm-level records (spec §4.1, §11.1)
// ---------------------------------------------------------------------------

/// Compliance manager (management body) and compliance officer appointments (Art. 11).
model Appointment {
  id        String    @id @default(uuid()) @db.Uuid
  firmId    String    @db.Uuid
  function  String // compliance-manager | compliance-officer
  userId    String    @db.Uuid
  fromDate  DateTime  @db.Date
  toDate    DateTime? @db.Date
  reason    String? // reason for ending the appointment
  createdAt DateTime  @default(now())

  @@index([firmId])
}

model TrainingModule {
  id          String   @id @default(uuid()) @db.Uuid
  firmId      String   @db.Uuid
  title       String
  content     String
  minutes     Int      @default(30)
  createdAt   DateTime @default(now())
  assignments TrainingAssignment[]

  @@index([firmId])
}

model TrainingAssignment {
  id          String         @id @default(uuid()) @db.Uuid
  firmId      String         @db.Uuid
  moduleId    String         @db.Uuid
  module      TrainingModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  userId      String         @db.Uuid
  assignedAt  DateTime       @default(now())
  dueOn       DateTime       @db.Date
  completedAt DateTime?
  attestation String? // "I completed this training and understood it" + name

  @@unique([moduleId, userId, dueOn])
  @@index([firmId])
}

/// Integrity, skills and conflict-of-interest declarations (Art. 13).
/// Staff screened against the firm's loaded sanctions/PEP lists (AMLR Art. 11 employee checks). Free: no paid provider.
model StaffScreening {
  id           String   @id @default(uuid()) @db.Uuid
  firmId       String   @db.Uuid
  userId       String   @db.Uuid
  listsChecked Int
  matches      Json // [{listName, matchedName, score, reference}]
  status       String // clear | possible-match | cleared | confirmed
  reviewNote   String?
  reviewedById String?  @db.Uuid
  screenedById String?  @db.Uuid
  screenedAt   DateTime @default(now())

  @@index([firmId, userId])
}

/// Company-register searches (kept so a firm sees its recent searches; counts towards free searches).
model KybSearch {
  id         String   @id @default(uuid()) @db.Uuid
  firmId     String   @db.Uuid
  userId     String   @db.Uuid
  country    String   @db.Char(2)
  query      String
  level      String // lite | full
  results    Json     // [{name, registrationNumber, status}] — candidate ids expire, so not kept
  at         DateTime @default(now())

  @@index([firmId, at])
}

/// External training events (workshops, seminars, courses) — Team → Training Register.
model ExternalTraining {
  id              String   @id @default(uuid()) @db.Uuid
  firmId          String   @db.Uuid
  title           String
  provider        String?
  type            String // workshop | seminar | online-course | internal-session | conference | other
  date            DateTime @db.Date
  durationMinutes Int
  attendeeIds     String[] @db.Uuid
  notes           String?
  createdById     String   @db.Uuid
  createdAt       DateTime @default(now())

  @@index([firmId])
}

model IntegrityDeclaration {
  id         String   @id @default(uuid()) @db.Uuid
  firmId     String   @db.Uuid
  userId     String   @db.Uuid
  kind       String // joining | annual
  answers    Json
  conflicts  String?
  declaredAt DateTime @default(now())

  @@index([firmId])
}

/// Internal whistleblowing channel (Art. 14, Directive 2019/1937). Content encrypted; reporter optional.
model WhistleblowingReport {
  id          String    @id @default(uuid()) @db.Uuid
  firmId      String    @db.Uuid
  contentEnc  Bytes
  reporterId  String?   @db.Uuid // null = anonymous
  status      String    @default("received") // received | acknowledged | closed
  acknowledgedAt DateTime?
  closedAt    DateTime?
  createdAt   DateTime  @default(now())

  @@index([firmId])
}

/// Outsourcing register (Art. 18).
model OutsourcingArrangement {
  id                   String    @id @default(uuid()) @db.Uuid
  firmId               String    @db.Uuid
  provider             String
  tasks                String
  agreementSignedOn    DateTime? @db.Date
  supervisorNotifiedOn DateTime? @db.Date
  startOn              DateTime? @db.Date
  endOn                DateTime? @db.Date
  notes                String?
  createdAt            DateTime  @default(now())

  @@index([firmId])
}

/// Every AI call (spec §5, §8C.8, §11.12): prompt and output encrypted per firm; no data used for training.
model AiCall {
  id           String   @id @default(uuid()) @db.Uuid
  firmId       String   @db.Uuid
  userId       String   @db.Uuid
  purpose      String // str-narrative | policy-section | …
  objectId     String?
  provider     String
  model        String
  promptEnc    Bytes
  outputEnc    Bytes?
  stopReason   String?
  inputTokens  Int?
  outputTokens Int?
  error        String?
  createdAt    DateTime @default(now())

  @@index([firmId, createdAt])
}

/// Just-in-time support access for AMLSyncAI staff (spec §8C.7): requested with a reason,
/// approved by the firm's Owner / Compliance Officer, limited in time and scope, logged.
model SupportGrant {
  id             String    @id @default(uuid()) @db.Uuid
  firmId         String    @db.Uuid
  requesterEmail String
  reason         String
  hours          Int
  scope          String    @default("read-only-summary")
  status         String    @default("requested") // requested | approved | denied | revoked
  decidedById    String?   @db.Uuid
  decidedAt      DateTime?
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())

  @@index([firmId])
}

// ---------------------------------------------------------------------------
// Didit identity verification and AML screening (paid checks)
// ---------------------------------------------------------------------------

model DiditSession {
  id             String    @id @default(uuid()) @db.Uuid
  firmId         String    @db.Uuid
  partyId        String    @db.Uuid
  cddFileId      String?   @db.Uuid
  kind           String // idv | aml
  diditSessionId String    @unique
  url            String?
  status         String    @default("Not Started")
  sandbox        Boolean   @default(true)
  creditEntryId  String?   @db.Uuid
  createdVia     String // staff | portal
  createdById    String?   @db.Uuid
  importedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([firmId])
  @@index([partyId])
}

/// Prepaid credit per firm (spec §6, recommendation 11): checks are charged when sent and refunded on failure or expiry.
model CreditEntry {
  id          String   @id @default(uuid()) @db.Uuid
  firmId      String   @db.Uuid
  amountCents Int // positive = top-up / refund / trial, negative = charge
  kind        String // trial | topup | charge | refund
  description String
  reference   String? // e.g. Didit session id
  clientRef   String? // client / matter reference shown on the receipt
  createdById String?  @db.Uuid
  invoiceId   String?  @db.Uuid // set once the entry is on an invoice
  createdAt   DateTime @default(now())

  @@index([firmId, createdAt])
  @@index([firmId, invoiceId])
}

/// One row per screening a person started (not automatic re-screening): basis for the screening limits.
model ScreeningEvent {
  id        String   @id @default(uuid()) @db.Uuid
  firmId    String   @db.Uuid
  partyId   String   @db.Uuid
  source    String // lists | didit
  createdAt DateTime @default(now())

  @@index([firmId, createdAt])
}

/// Monthly VAT invoice (Lithuanian PVM sąskaita faktūra): continuous numbering, snapshots of seller and buyer.
model Invoice {
  id          String    @id @default(uuid()) @db.Uuid
  firmId      String    @db.Uuid
  seq         Int       @unique
  number      String    @unique
  period      String // YYYY-MM
  issuedOn    String // YYYY-MM-DD
  dueOn       String
  seller      Json
  buyer       Json
  lines       Json
  netCents    Int
  vatRateBp   Int
  vatCents    Int
  totalCents  Int
  vatNote     String?
  status      String    @default("issued") // issued | paid | void
  paidOn      String?
  paymentRef  String?
  createdAt   DateTime  @default(now())

  @@unique([firmId, period])
  @@index([firmId])
}

/// Encrypted file bytes when STORAGE_DRIVER=db (small installations / test environments without object storage).
model Blob {
  key       String   @id
  data      Bytes
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Backoffice (docs/BACKOFFICE_SPEC.md). AMLSyncAI-internal tables: row-level
// security is enabled without policies (prisma/rls.sql), so the tenant
// connection can read none of them. They never hold customers' client data.
// ---------------------------------------------------------------------------

/// AMLSyncAI admin team (§4.1). Emails in PLATFORM_ADMIN_EMAILS are always Owners.
model AdminMember {
  email      String    @id
  roles      String[] // OWNER | OPERATIONS | SUPPORT | FINANCE | SECURITY | CONTENT_EDITOR | CONTENT_REVIEWER | SALES | AUDITOR
  addedBy    String
  createdAt  DateTime  @default(now())
  removedAt  DateTime?
  reviewedAt DateTime? // quarterly access review (§4.2)
  reviewedBy String?
}

/// Append-only, hash-chained log of every admin action (§2.4, §21).
model AdminAuditEvent {
  id            BigInt   @id @default(autoincrement())
  at            DateTime
  adminEmail    String
  action        String
  targetType    String
  targetId      String?
  reason        String?
  details       Json?
  approverEmail String?
  prevHash      String
  hash          String   @unique

  @@index([targetType, targetId])
  @@index([adminEmail, at])
}

/// Four-eyes approvals for dangerous actions (§2.5).
model AdminApproval {
  id          String    @id @default(uuid()) @db.Uuid
  action      String // credit.grant | admin.set-roles | firm.close | firms.export
  payload     Json
  summary     String
  reason      String
  requestedBy String
  status      String    @default("pending") // pending | executed | rejected | failed | expired
  decidedBy   String?
  decidedAt   DateTime?
  result      String?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  @@index([status, createdAt])
}

/// Internal notes, tags and account owner per firm (§6.2 Overview).
model FirmAdminMeta {
  firmId         String   @id @db.Uuid
  tags           String[]
  accountManager String?
  updatedAt      DateTime @updatedAt
}

model FirmNote {
  id          String   @id @default(uuid()) @db.Uuid
  firmId      String   @db.Uuid
  authorEmail String
  text        String
  createdAt   DateTime @default(now())

  @@index([firmId, createdAt])
}

/// AMLSyncAI's own KYB of a customer firm (§6.2): registry reference, directors, BOs, sanctions screening.
model FirmKyb {
  id               String   @id @default(uuid()) @db.Uuid
  firmId           String   @db.Uuid
  registryRef      String?
  directors        String[]
  beneficialOwners String[]
  russiaBelarus    String // none | link-found | not-checked (Reg. 833/2014 restrictions [verify])
  result           String // clear | possible-match | confirmed-hit
  matches          Json // [{ subject, matchedName, list, score }]
  decision         String? // cleared | blocked (after review of a possible match)
  decisionNote     String?
  checkedBy        String
  checkedAt        DateTime @default(now())

  @@index([firmId, checkedAt])
}

/// Incident and personal-data-breach register (§10.3).
model Incident {
  id                  String    @id @default(uuid()) @db.Uuid
  title               String
  severity            String // sev1 | sev2 | sev3 | sev4
  status              String    @default("open") // open | contained | resolved | closed
  personalData        Boolean   @default(false)
  controllerData      Boolean   @default(false) // AMLSync is controller (visitors, leads, own users): 72-hour DPA clock
  systems             String[]
  firmIds             String[]
  summary             String
  rootCause           String?
  detectedAt          DateTime
  resolvedAt          DateTime?
  firmsNotifiedAt     DateTime?
  dpaNotifiedAt       DateTime?
  dpaNotRequiredReason String?
  public              Boolean   @default(false) // shown on the public status page
  publicSummary       String?
  createdBy           String
  createdAt           DateTime  @default(now())
  updates             IncidentUpdate[]
}

model IncidentUpdate {
  id          String   @id @default(uuid()) @db.Uuid
  incidentId  String   @db.Uuid
  incident    Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  authorEmail String
  text        String
  at          DateTime @default(now())

  @@index([incidentId])
}

/// Data subject requests to AMLSync (§12.2).
model DataSubjectRequest {
  id             String    @id @default(uuid()) @db.Uuid
  receivedOn     String // YYYY-MM-DD
  requesterName  String
  requesterEmail String
  kind           String // access | erasure | rectification | portability | objection | restriction
  role           String // controller | processor
  firmId         String?   @db.Uuid // processor requests: the firm it was forwarded to
  status         String    @default("received") // received | identity-check | in-progress | forwarded | completed | rejected
  dueOn          String
  extended       Boolean   @default(false)
  notes          String?
  closedAt       DateTime?
  createdBy      String
  createdAt      DateTime  @default(now())
}

/// First-party, cookieless audience measurement (Backoffice §7.5–7.6). No IP, no cookie:
/// `visitor` is a hash of IP + user agent with a salt that changes every day.
model WebEvent {
  id          BigInt   @id @default(autoincrement())
  at          DateTime @default(now())
  site        String // web (amlsync.com) | app (app.amlsync.com public pages)
  kind        String   @default("pageview") // pageview | event
  name        String? // event name, e.g. contact_submit, app_cta
  path        String
  referrer    String? // host only
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  country     String?  @db.Char(2)
  device      String // desktop | mobile | tablet
  browser     String
  lang        String?
  visitor     String
  bot         String? // null = human

  @@index([at])
  @@index([visitor])
}

/// Leads (light CRM, §7.3) — kept in AMLSync's own database instead of a CRM tool.
model Lead {
  id         String    @id @default(uuid()) @db.Uuid
  name       String
  email      String
  company    String?
  country    String?   @db.Char(2)
  need       String?
  message    String?
  source     String // website-form | unfinished-signup | manual
  stage      String    @default("new") // new | contacted | demo | trial | customer | lost
  owner      String?
  nextStep   String?
  nextStepOn String?
  lostReason String?
  firmId     String?   @db.Uuid
  visitor    String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  notes      LeadNote[]

  @@index([email])
  @@index([stage])
}

model LeadNote {
  id          String   @id @default(uuid()) @db.Uuid
  leadId      String   @db.Uuid
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorEmail String
  text        String
  createdAt   DateTime @default(now())

  @@index([leadId])
}

/// Support tickets (§16): raised by firm users in the app, answered in the Backoffice.
model Ticket {
  id              String    @id @default(uuid()) @db.Uuid
  number          Int       @unique @default(autoincrement())
  firmId          String    @db.Uuid
  userId          String    @db.Uuid
  subject         String
  category        String // technical | billing | account | advisory | other
  priority        String // P1 | P2 | P3
  status          String    @default("open") // open | waiting-customer | resolved | closed
  slaDueAt        DateTime
  firstResponseAt DateTime?
  resolvedAt      DateTime?
  csat            Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  messages        TicketMessage[]

  @@index([firmId, createdAt])
  @@index([status])
}

model TicketMessage {
  id          String   @id @default(uuid()) @db.Uuid
  ticketId    String   @db.Uuid
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  fromTeam    Boolean
  authorEmail String
  text        String
  createdAt   DateTime @default(now())

  @@index([ticketId])
}

/// Communications (§18): in-app banner and optional email to a segment of firms.
model Announcement {
  id         String    @id @default(uuid()) @db.Uuid
  title      String
  body       String
  level      String    @default("info") // info | warning
  audience   Json // { country?, plan?, status?, sector? }; {} = all firms
  startsAt   DateTime  @default(now())
  endsAt     DateTime?
  email      Boolean   @default(false)
  emailState String    @default("none") // none | awaiting-approval | sent
  emailCount Int       @default(0)
  createdBy  String
  createdAt  DateTime  @default(now())
  dismissals AnnouncementDismissal[]
}

model AnnouncementDismissal {
  announcementId String       @db.Uuid
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String       @db.Uuid
  at             DateTime     @default(now())

  @@id([announcementId, userId])
}

/// Vendor unit costs and monthly vendor invoices (§9.5).
model VendorPrice {
  id            String   @id @default(uuid()) @db.Uuid
  vendor        String // didit
  checkType     String // charge description key, e.g. idv | aml | registry
  unitCostCents Int
  validFrom     String // YYYY-MM-DD
  createdBy     String
  createdAt     DateTime @default(now())
}

model VendorInvoice {
  id          String   @id @default(uuid()) @db.Uuid
  vendor      String
  period      String // YYYY-MM
  amountCents Int
  reference   String?
  createdBy   String
  createdAt   DateTime @default(now())

  @@unique([vendor, period])
}

/// AMLSync Expert / managed service (§19) under Art. 18 outsourcing agreements.
model ExpertEngagement {
  id                 String    @id @default(uuid()) @db.Uuid
  firmId             String    @db.Uuid
  scope              String
  agreementOn        String // YYYY-MM-DD, Art. 18 agreement signed
  supervisorNotified Boolean   @default(false)
  hourlyCents        Int?
  status             String    @default("active") // active | ended
  createdBy          String
  createdAt          DateTime  @default(now())
  tasks              ExpertTask[]
}

model ExpertTask {
  id           String           @id @default(uuid()) @db.Uuid
  engagementId String           @db.Uuid
  engagement   ExpertEngagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  title        String
  dueOn        String?
  analyst      String?
  status       String           @default("todo") // todo | in-progress | review | done
  minutes      Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

/// One row per scheduled job run (platform-level, not tenant data): lets operations see failures and missed runs.
model JobRun {
  id         String    @id @default(uuid()) @db.Uuid
  job        String // "daily"
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  ok         Boolean   @default(false)
  failed     String[] // names of the parts that failed
  summary    Json      @default("{}")

  @@index([job, startedAt])
}

/// A client file sent by one firm to another (with the client's agreement or another legal basis).
/// Not tenant-scoped: read and written only through src/lib/server/sharing.ts, which checks both firm ids.
/// The package is encrypted with the receiving firm's key; document copies are written under its key too.
model ClientShare {
  id            String    @id @default(uuid()) @db.Uuid
  fromFirmId    String    @db.Uuid
  toFirmId      String    @db.Uuid
  sourceFileId  String    @db.Uuid
  clientName    String
  note          String    @default("")
  legalBasis    String
  status        String    @default("pending") // pending | accepted | declined | withdrawn | expired
  packageEnc    Bytes
  documents     Json      // [{ key, fileName, kind, mimeType, sizeBytes, sha256 }]
  createdBy     String    @db.Uuid
  createdAt     DateTime  @default(now())
  expiresAt     DateTime
  decidedAt     DateTime?
  decidedBy     String?   @db.Uuid
  importedFileId String?  @db.Uuid

  @@index([toFirmId, status])
  @@index([fromFirmId])
}

/// ECB euro reference rates (USD per 1 EUR), fetched by the app; client prices for Didit services are computed from them.
model FxRate {
  date      String   @id // YYYY-MM-DD, the ECB reference date
  usdPerEur Decimal  @db.Decimal(10, 4)
  fetchedAt DateTime @default(now())
}

/// A transaction file upload: previewed first, imported on confirmation, undoable for 24 hours.
model TxImportBatch {
  id          String    @id @default(uuid()) @db.Uuid
  firmId      String    @db.Uuid
  fileName    String
  status      String    @default("preview") // preview | imported | cancelled | undone
  rows        Json      // the checked rows: [{ line, raw, ok, error?, flags?, data? }]
  imported    Int       @default(0)
  duplicates  Int       @default(0)
  rejected    Int       @default(0)
  flagged     Int       @default(0)
  createdById String    @db.Uuid
  createdAt   DateTime  @default(now())
  importedAt  DateTime?
  undoneAt    DateTime?

  @@index([firmId, createdAt])
}

/// High-risk countries used by transaction monitoring (R7): the EU list (Art. 29), kept up to date by AMLSync App admins.
model HighRiskCountry {
  code      String   @id @db.Char(2)
  list      String   @default("EU high-risk third country")
  note      String?
  updatedAt DateTime @default(now())
}
